root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

[*.{ts,tsx,js,mjs,cjs,json,jsonc,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
insert_final_newline = false

[*.{py,rb}]
indent_size = 4

[Makefile]
indent_style = tab