{
  "name": "pezhwan",
  "version": "0.1.0",
  "private": true,
  "description": "Pezhwan (پېژوان) — One Identity. Every Application. Universal Identity & Access Management SDK.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @pezhwan/shared && npm run build -w @pezhwan/crypto && npm run build -w @pezhwan/oauth && npm run build -w @pezhwan/core && npm run build -w @pezhwan/node && npm run build -w @pezhwan/express && npm run build -w @pezhwan/react && npm run build -w @pezhwan/identity-server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "license:check": "license-checker --failOn \";GPL;LGPL;AGPL;MPL;EPL;CDDL\" --excludePrivatePackages",
    "test": "npm run build && npm run test --workspaces --if-present",
    "test:security": "node scripts/secret-scan.mjs --ci",
    "test:integration": "npm run build && node --test tests/integration/*.test.ts",
    "test:coverage": "npm run build && node --experimental-test-coverage --test tests/integration/*.test.ts",
    "sbom": "npm sbom --sbom-format=cyclonedx",
    "verify:compose": "docker compose -f infrastructure/docker/docker-compose.yml config --quiet",
    "migrate:mfa": "node scripts/migrate-mfa-secrets.mjs",
    "drill:backup": "node scripts/backup-drill.mjs --seed",
    "drill:restore": "node scripts/restore-drill.mjs --verify-auth",
    "drill:backup-restore": "node scripts/backup-drill.mjs --seed && node scripts/restore-drill.mjs --verify-auth --in backups/latest.pzbu",
    "clean": "npm run clean --workspaces --if-present",
    "setup": "node scripts/install-hooks.mjs && node -e \"console.log('Pezhwan setup complete. Copy .env.example to .env and fill in required values.')\""
  },
  "allowScripts": {
    "argon2@0.45.1": true
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "license-checker": "^25.0.1",
    "mongodb-memory-server": "^11.2.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0"
  }
}
