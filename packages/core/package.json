{
  "name": "@pezhwan/core",
  "version": "0.1.0",
  "description": "Pezhwan core domain — user/tenant/application/role models, auth engine, session management, RBAC.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pezhwan/shared": "*",
    "@pezhwan/crypto": "*",
    "mongoose": "^8.0.0",
    "ioredis": "^5.4.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^22.0.0"
  }
}
