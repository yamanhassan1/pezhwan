{
  "name": "@pezhwan/vue",
  "version": "0.1.0",
  "description": "Pezhwan Vue 3 SDK — plugin, useAuth(), useMFA(), useSession(), login/register components.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vue-tsc -p tsconfig.json --emitDeclarationOnly && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "@pezhwan/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.5.0",
    "vite": "^6.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0"
  }
}