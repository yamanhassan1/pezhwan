  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@angular/common": "^19.0.0",
    "@angular/core": "^19.0.0",
    "@angular/router": "^22.1.5",
    "rxjs": "^7.8.0",
    "@pezhwan/shared": "*"
  },
  "devDependencies": {
    "@angular/compiler": "^19.0.0",
    "@types/node": "^26.4.0",
    "typescript": "^5.5.0"
  }
}