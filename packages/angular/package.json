{
  "name": "@pezhwan/angular",
  "version": "0.1.0",
  "description": "Pezhwan Angular SDK — PezhwanModule, AuthService, SessionService, auth guard and HTTP interceptor.",
  "private": true,
  "type": "module",
  "main": "./dist/public-api.js",
