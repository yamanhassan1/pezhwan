{
  "name": "@pezhwan/node",
  "version": "0.1.0",
  "description": "Pezhwan Node.js SDK — builds the auth runtime, exposes authentication/session/authorization APIs for any Node application.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pezhwan/core": "*",
    "@pezhwan/shared": "*",
    "@pezhwan/crypto": "*"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^26.4.0"
  }
}
