{
  "name": "@pezhwan/oauth",
  "version": "0.1.0",
  "description": "Pezhwan OAuth/OIDC provider adapters — Google, Apple, GitHub, Microsoft. Modular, framework independent.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pezhwan/shared": "*"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.4.0"
  }
}