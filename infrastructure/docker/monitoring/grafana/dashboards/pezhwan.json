{
  "uid": "pezhwan-overview",
  "title": "Pezhwan Identity Server",
  "description": "Authentication, authorization, MFA/OTP, rate-limit, and infrastructure health for the Pezhwan IAM stack.",
  "tags": ["pezhwan", "iam", "identity"],
  "timezone": "utc",
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "selected": true, "text": "Prometheus", "value": "Prometheus" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Login Success Rate",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "pointSize": 5,
            "showPoints": "auto"
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(auth_login_success_total{job=\"identity-server\"}[5m])",
          "legendFormat": "Login Success",
          "refId": "A"
        },
        {
          "expr": "rate(auth_login_failed_total{job=\"identity-server\"}[5m])",
          "legendFormat": "Login Failure",
          "refId": "B"
        }
      ]
    },
    {
      "id": 2,
      "title": "Login Failure Ratio",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.2 }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(auth_login_failed_total{job=\"identity-server\"}[5m]) / clamp_min(rate(auth_login_success_total{job=\"identity-server\"}[5m]) + rate(auth_login_failed_total{job=\"identity-server\"}[5m]), 0.001)",
          "legendFormat": "Failure Ratio",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Registrations",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue", "value": null }] },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(auth_register_total{job=\"identity-server\"}[5m])",
          "legendFormat": "New Users (5m)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "OTP Sent vs Failed",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(auth_otp_sent_total{job=\"identity-server\"}[5m])",
          "legendFormat": "OTP Sent",
          "refId": "A"
        },
        {
          "expr": "rate(auth_otp_failed_total{job=\"identity-server\"}[5m])",
          "legendFormat": "OTP Failed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "title": "MFA Verification",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(auth_mfa_success_total{job=\"identity-server\"}[5m])",
          "legendFormat": "MFA Success",
          "refId": "A"
        },
        {
          "expr": "rate(auth_mfa_failed_total{job=\"identity-server\"}[5m])",
          "legendFormat": "MFA Failed",
          "refId": "B"
        }
      ]
    },
    {
      "id": 6,
      "title": "Refresh Token Reuse",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80 },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(auth_refresh_reuse_total{job=\"identity-server\"}[5m])",
          "legendFormat": "Refresh Reuse (5m)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "OAuth Grants / Exchanges",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(auth_oauth_authoried_total{job=\"identity-server\"}[5m])",
          "legendFormat": "OAuth Authorized",
          "refId": "A"
        },
        {
          "expr": "rate(auth_oauth_exchanged_total{job=\"identity-server\"}[5m])",
          "legendFormat": "OAuth Exchanged",
          "refId": "B"
        }
      ]
    },
    {
      "id": 8,
      "title": "Rate Limit Hits",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "orange", "mode": "fixed" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(ratelimit_hit_total{job=\"identity-server\"}[5m])",
          "legendFormat": "Rate Limit Rejections",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Authorization Denials",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "yellow", "mode": "fixed" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 15 },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(authz_denied_total{job=\"identity-server\"}[5m])",
          "legendFormat": "Authz Denials",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Security Events",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "dark-red", "mode": "fixed" },
          "custom": { "drawStyle": "bars", "lineWidth": 1, "fillOpacity": 80 },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(security_event_total{job=\"identity-server\"}[5m])",
          "legendFormat": "Security Events (5m)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Token Revocations",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 10 },
              { "color": "red", "value": 50 }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(token_revoked_total{job=\"identity-server\"}[5m])",
          "legendFormat": "Revocations (5m)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "title": "API Key Auth",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 32 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "purple", "value": null }] },
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(auth_api_key_total{job=\"identity-server\"}[5m])",
          "legendFormat": "API Key Requests",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "MongoDB Up",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 0, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"mongodb\"}",
          "legendFormat": "MongoDB",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "Redis Up",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 4, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "up{job=\"redis\"}",
          "legendFormat": "Redis",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Identity Server Uptime",
      "type": "stat",
      "gridPos": { "h": 8, "w": 4, "x": 8, "y": 40 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "green", "value": null }] },
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "process_start_time_seconds{job=\"identity-server\"}",
          "legendFormat": "Process Start",
          "refId": "A"
        }
      ]
    }
  ]
}
