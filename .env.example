#   PEZHWAN — Environment Configuration Template                          
#                                                                         
#   SETUP:                                                                 
#     1. Copy this file:  cp .env.example .env                            
#     2. Fill in required values (marked with REQUIRED)                    
#     3. Never commit .env to Git                                          
#     4. Never share production credentials                                
#     5. Never place secrets in frontend code                              
#                                                                         
#   GENERATE SECRETS LOCALLY (do NOT commit the output):                  
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"  ║
#                                                                         
#   To generate a 64-byte secret:                                         
#     node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"


# ── Node ──────────────────────────────────────────────────────────────────
NODE_ENV=development

# ── Server ────────────────────────────────────────────────────────────────
PEZHWAN_PORT=4011
# Max accepted JSON request body (e.g. "100kb", "1mb")
PEZHWAN_BODY_LIMIT=100kb

# ── Issuer (REQUIRED) ─────────────────────────────────────────────────────
# The public issuer URL. Must match the URL clients use to reach this server.
# Local development defaults are intentionally set to the reference identity
# server so the browser demo works without extra configuration.
PEZHWAN_ISSUER=http://localhost:4011

# ── Tenant / Application (REQUIRED) ───────────────────────────────────────
# Unique identifiers for the default tenant and application.
PEZHWAN_TENANT_ID=your-tenant-id
PEZHWAN_APPLICATION_ID=your-application-id

# ── Database ──────────────────────────────────────────────────────────────
PEZHWAN_MONGODB_URI=mongodb://localhost:27017/pezhwan
PEZHWAN_MONGO_POOL_SIZE=10
PEZHWAN_MONGO_TIMEOUT_MS=1500

# ── Redis (optional — degrades to in-memory if absent) ────────────────────
PEZHWAN_REDIS_URL=redis://localhost:6379

# ── Tokens ────────────────────────────────────────────────────────────────
PEZHWAN_ACCESS_TOKEN_TTL=15m
PEZHWAN_REFRESH_TOKEN_TTL=30d
PEZHWAN_SESSION_TTL=30d
PEZHWAN_JWT_ALGORITHM=RS256
PEZHWAN_JWKS_CACHE_TTL=300

# ── Signing keys ──────────────────────────────────────────────────────────
# Auto-generated on first boot if absent. Override for HA multi-instance.
PEZHWAN_SIGNING_KEYS_PATH=./keys
# Rotation cadence for the persisted signing keys (ms). 0 disables rotation.
# (Capped at Node's setInterval maximum ~24.8d = 2147483000)
PEZHWAN_SIGNING_KEY_ROTATION_MS=2147483000

# ── Cookie security ───────────────────────────────────────────────────────
PEZHWAN_COOKIE_DOMAIN=
PEZHWAN_COOKIE_SECURE=false
PEZHWAN_COOKIE_SAMESITE=lax

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Include the browser demo origins used
# when the app is served through Live Server or the built-in static server.
PEZHWAN_ALLOWED_ORIGINS=http://localhost:4011,http://127.0.0.1:4011,http://localhost:5173,http://127.0.0.1:5500

# ── OTP ───────────────────────────────────────────────────────────────────
PEZHWAN_OTP_TTL=300000
PEZHWAN_OTP_MAX_ATTEMPTS=5
PEZHWAN_OTP_RESEND_COOLDOWN=30000
PEZHWAN_OTP_LENGTH=6

# ── Rate limiting ─────────────────────────────────────────────────────────
PEZHWAN_RATE_LIMIT_LOGIN=10/15m
PEZHWAN_RATE_LIMIT_OTP=5/10m
PEZHWAN_RATE_LIMIT_API=100/15m
PEZHWAN_LOCKOUT_MAX_ATTEMPTS=5
PEZHWAN_LOCKOUT_DURATION=900000

# ── Observability ─────────────────────────────────────────────────────────
PEZHWAN_OTEL_ENDPOINT=
PEZHWAN_REQUEST_LOGGING=true
PEZHWAN_LOG_LEVEL=info
